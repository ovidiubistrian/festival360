# Copy to .env and adjust. NEVER commit the real .env.

# --- App ---
PROJECT_NAME=Festival Hub API
ENVIRONMENT=development

# --- Database ---
# Local dev (Docker Compose):
DATABASE_URL=postgresql+psycopg://festival:festival@localhost:5432/festival360
# Production (Neon) — use the pooled connection string, swap the scheme to
# postgresql+psycopg, e.g.:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- CORS (frontend origins, comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Seed demo data on startup if DB is empty ---
SEED_ON_STARTUP=true
