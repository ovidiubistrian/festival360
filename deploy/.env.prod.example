# Copy to `.env` on the VPS (next to docker-compose.prod.yml). NEVER commit the real file.

# --- Domains (DNS A records must point at the VPS) ---
DOMAIN=festival360.ro
API_DOMAIN=api.festival360.ro
# Email for Let's Encrypt (ACME) certificate registration.
ACME_EMAIL=admin@festival360.ro
# Tenant custom domains: their A/ALIAS record must point at this VPS. Caddy issues
# certs on demand (gated by the API's /caddy/check-domain), no per-domain config.

# --- Images (pushed to GHCR by GitHub Actions; lowercased owner/repo) ---
WEB_IMAGE=ghcr.io/ovidiubistrian/festival360-web:latest
API_IMAGE=ghcr.io/ovidiubistrian/festival360-api:latest

# --- Postgres ---
POSTGRES_USER=festival
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=festival360

# --- API ---
SECRET_KEY=change-me-long-random-string
SEED_ON_STARTUP=true
